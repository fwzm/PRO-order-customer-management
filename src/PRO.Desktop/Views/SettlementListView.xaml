<UserControl x:Class="PRO.Desktop.Views.SettlementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="财务结算" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="新建结算" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding NewSettlementCommand}"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="批量下载PDF" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BatchDownloadPdfCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name"
                          SelectedValue="{Binding SelectedBranchId}" SelectedValuePath="Id"
                          Width="150" Margin="0,0,12,0"
                          materialDesign:HintAssist.Hint="选择分公司"/>
                <TextBlock Text="时间范围：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterStartDate}" Width="130" Margin="0,0,8,0"/>
                <TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterEndDate}" Width="130" Margin="0,0,16,0"/>
                
                <Button Content="查询" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8"
                        Command="{Binding QueryCommand}"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="16,8"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- 结算概览 -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="24,16,24,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="未结算池" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                        <Run Text="{Binding Overview.UnsettledOrderCount}"/><Run Text=" 单" FontSize="13"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource SecondaryLabelBrush}" FontSize="12">
                        <Run Text="¥"/><Run Text="{Binding Overview.UnsettledTotalAmount, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="待收金额" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0">
                        <Run Text="¥"/><Run Text="{Binding Overview.UnsettledReceivableAmount, StringFormat=N0}"/>
                    </TextBlock>
                    <TextBlock Text="未结算订单应收" Foreground="{StaticResource SecondaryLabelBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="异常订单" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock Text="{Binding Overview.AbnormalOrderCount}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="多付/少付/长期未结算" Foreground="{StaticResource SecondaryLabelBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="PDF待生成" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock Text="{Binding Overview.PendingPdfCount}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="本月结算待补齐" Foreground="{StaticResource SecondaryLabelBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 数据表格 -->
        <Border Grid.Row="3" Margin="24,16">
            <Grid>
            <!-- 统一空状态控件 -->
            <controls:EmptyStateControl DataContext="{Binding EmptyState}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <DataGrid ItemsSource="{Binding Settlements}"
                      SelectedItem="{Binding SelectedSettlement}"
                      Style="{StaticResource DataGridStyle}"
                      IsReadOnly="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="结算单号" Binding="{Binding SettlementNo}" Width="160"/>
                    <DataGridTextColumn Header="结算时间" Width="200">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0:yyyy-MM-dd} 至 {1:yyyy-MM-dd}">
                                <Binding Path="StartDate"/>
                                <Binding Path="EndDate"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="分公司" Binding="{Binding BranchName}" Width="120"/>
                    <DataGridTextColumn Header="确认人" Binding="{Binding ConfirmedByName}" Width="80"/>
                    <DataGridTextColumn Header="订单数" Binding="{Binding OrderCount}" Width="70"/>
                    <DataGridTextColumn Header="总金额" Binding="{Binding TotalAmount, StringFormat=¥{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="收款金额" Binding="{Binding ReceivedAmount, StringFormat=¥{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="未收款" Binding="{Binding UnpaidAmount, StringFormat=¥{0:N2}}" Width="100"/>
                    <DataGridTemplateColumn Header="操作" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="查看" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.ViewSettlementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Content="下载PDF" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.DownloadPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- 分页栏 -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="共"/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text="条结算记录（近30天）"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="首页" Command="{Binding FirstPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0">
                        <Run Text="第"/>
                        <Run Text="{Binding PageIndex}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalPages}"/>
                        <Run Text="页"/>
                    </TextBlock>
                    <Button Content="下一页" Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

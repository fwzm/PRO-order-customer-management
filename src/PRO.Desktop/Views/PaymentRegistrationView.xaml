<UserControl x:Class="PRO.Desktop.Views.PaymentRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="收款登记" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding RefreshCommand}" Margin="16,0,0,0" Padding="12,6"/>
            <Button Content="新增收款" Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding OpenAddPaymentCommand}" Margin="8,0,0,0" Padding="12,6"/>
            <Button Content="统计" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding LoadStatsCommand}" Margin="8,0,0,0" Padding="12,6"/>
        </StackPanel>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" SelectedDate="{Binding FilterStartDate}" Width="130"
                            materialDesign:HintAssist.Hint="开始日期"/>
                <DatePicker Grid.Column="2" SelectedDate="{Binding FilterEndDate}" Width="130"
                            materialDesign:HintAssist.Hint="结束日期"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="今天" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterTodayCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="本周" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterThisWeekCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="本月" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterThisMonthCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="清除" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFilterCommand}" Padding="8,4"/>
                </StackPanel>

                <Button Grid.Column="6" Content="导出" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportToExcelCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 收款列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Payments}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                  BorderThickness="0" Background="{StaticResource SurfaceBrush}"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="收款单号" Binding="{Binding PaymentNo}" Width="130"/>
                <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="130"/>
                <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="120"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="支付方式" Binding="{Binding PaymentMethodName}" Width="80"/>
                <DataGridTextColumn Header="收款人" Binding="{Binding ReceivedByName}" Width="80"/>
                <DataGridTextColumn Header="收款时间" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" Padding="8,4" Foreground="Red"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 空状态 -->
        <controls:EmptyStateControl Grid.Row="2" DataContext="{Binding EmptyState}"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- 统计卡片 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                Visibility="{Binding ShowStats, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="总收款" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="¥"/><Run Text="{Binding Stats.TotalReceived, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="收款笔数" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock Text="{Binding Stats.TotalCount}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="现金" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="¥"/><Run Text="{Binding Stats.CashAmount, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="微信" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="¥"/><Run Text="{Binding Stats.WeChatAmount, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

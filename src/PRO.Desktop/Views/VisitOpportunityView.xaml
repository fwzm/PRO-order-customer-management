<UserControl x:Class="PRO.Desktop.Views.VisitOpportunityView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.xml-lab.org/expression/blend/2008" 
        xmlns:local="clr-namespace:PRO.Desktop.Views"
        xmlns:vm="clr-namespace:PRO.Desktop.ViewModels"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签选择器 -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="10" Padding="6" Margin="24,20,24,12"
                BorderBrush="{StaticResource FillBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="拜访同步"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="0"
                        Margin="2,0" Padding="16,6" Cursor="Hand"
                        FontSize="13" FontWeight="Medium" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ApplePlainButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TertiaryLabelBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="商机管理"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="1"
                        Margin="2,0" Padding="16,6" Cursor="Hand"
                        FontSize="13" FontWeight="Medium" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ApplePlainButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TertiaryLabelBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 内容区域 -->
        <ContentControl Grid.Row="1" Margin="24,0,24,20">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                            <Setter Property="Content" Value="{Binding VisitSyncVm}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                            <Setter Property="Content" Value="{Binding OpportunityVm}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
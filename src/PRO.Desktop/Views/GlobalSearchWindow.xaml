<Window x:Class="PRO.Desktop.Views.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="全局搜索 (Ctrl+K)"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <Border Grid.Row="0" Style="{StaticResource AppleCardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                          Foreground="{StaticResource TertiaryLabelBrush}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="SearchInput"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" Margin="10,0,0,0"
                         materialDesign:HintAssist.Hint="搜索客户名、手机号、订单号、产品或拼音首字母，如 zs"/>
                <TextBlock Grid.Column="2" Text="Esc 关闭" FontSize="11"
                           Foreground="{StaticResource QuaternaryLabelBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 结果计数 -->
        <TextBlock Grid.Row="1" Text="{Binding ResultCountText}" FontSize="12"
                   Foreground="{StaticResource TertiaryLabelBrush}" Margin="4,0,0,8"/>

        <!-- 搜索结果列表 -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedItem}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <EventSetter Event="MouseDoubleClick" Handler="ResultItem_MouseDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 类型图标 -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource FillBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Icon}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 标题和副标题 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource LabelBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- 类型标签 -->
                            <Border Grid.Column="2" Background="{StaticResource AccentDimBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}" Margin="48,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Click="SearchAction_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            Margin="0,0,6,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Text="↑↓ 选择  ·  Enter 打开  ·  Esc 关闭" FontSize="11"
                   Foreground="{StaticResource QuaternaryLabelBrush}" HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

        <!-- 加载指示器 -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Window>

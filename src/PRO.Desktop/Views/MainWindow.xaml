<Window x:Class="PRO.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PRO.Desktop.Views"
        xmlns:vm="clr-namespace:PRO.Desktop.ViewModels"
        xmlns:controls="clr-namespace:PRO.Desktop.Controls"
        mc:Ignorable="d"
        Title="PRO"
        Height="768" Width="1300"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        TextElement.Foreground="{StaticResource LabelBrush}"
        TextElement.FontWeight="Normal"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><local:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerListViewModel}"><local:CustomerListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderListViewModel}"><local:OrderListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductListViewModel}"><local:ProductListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryPersonListViewModel}"><local:DeliveryPersonListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettlementListViewModel}"><local:SettlementListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkScheduleViewModel}"><local:WorkScheduleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemSettingsViewModel}"><local:SystemSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusinessDistrictViewModel}"><local:BusinessDistrictView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeChatScrmViewModel}"><local:WeChatScrmView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeListViewModel}"><local:EmployeeListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpportunityViewModel}"><local:OpportunityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><local:InventoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeChatVisitSyncViewModel}"><local:WeChatVisitSyncView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagViewModel}"><local:TagView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsReceivableViewModel}"><local:AccountsReceivableView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportCenterViewModel}"><local:ReportCenterView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PredictionDashboardViewModel}"><local:PredictionDashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisitOpportunityViewModel}"><local:VisitOpportunityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DistrictTagViewModel}"><local:DistrictTagView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OperationLogViewModel}"><local:OperationLogView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:ToastNotification x:Name="ToastCtrl" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,12,12,0" Panel.ZIndex="999"/>

        <!-- 连接状态提示条 -->
        <Border x:Name="ConnectionBanner" Grid.ColumnSpan="2" VerticalAlignment="Top"
                Background="#FFF3CD" Padding="12,6" Panel.ZIndex="998" Visibility="Collapsed">
            <TextBlock x:Name="ConnectionBannerText" Text="网络连接不稳定，正在重连..."
                       Foreground="#856404" FontSize="12" HorizontalAlignment="Center"/>
        </Border>

        <!-- ==================== 侧边栏 ==================== -->
        <!-- 用和正常页面统一的 SurfaceBrush 背景、BorderBrush 分割线 -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo —— 纯文字 Apple 风格 -->
                <Grid Grid.Row="0" Margin="18,0,14,0">
                    <TextBlock Text="PRO" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource LabelBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 搜索栏 —— 常驻 Apple 风格 -->
                <Border Grid.Row="1" Padding="14,6,14,10">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SidebarSearchBoxStyle}"/>
                </Border>

                <!-- 导航菜单 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,4,10,8">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 分隔线 -->
                                    <Rectangle Height="1" Fill="{StaticResource FillBrush}" Margin="8,6,8,6"
                                               Visibility="{Binding Id, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=sep1}"/>

                                    <!-- ===== 分类目录 ===== -->
                                    <StackPanel Visibility="{Binding IsCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- 分类标题 —— 纯文字 Apple 风格 + 下拉标志 -->
                                        <Button Command="{Binding DataContext.ToggleCategoryCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppleSidebarItemStyle}"
                                                HorizontalContentAlignment="Stretch"
                                                Height="36" Margin="8,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                                                           Foreground="{StaticResource LabelBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="›" FontSize="18"
                                                           Foreground="{StaticResource LabelBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- 子菜单项 —— 纯文字 Apple 风格 -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateToTabCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AppleSidebarChildStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SecondaryLabelBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                            <Border Grid.Column="1"
                                                                    Style="{StaticResource BadgeStyle}"
                                                                    Visibility="{Binding BadgeCount, Converter={StaticResource BadgeVisibilityConverter}}">
                                                                <TextBlock Text="{Binding BadgeCount, Converter={StaticResource BadgeTextConverter}}"
                                                                           Style="{StaticResource BadgeTextStyle}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- ===== 单层菜单项 —— 纯文字 Apple 风格 ===== -->
                                    <Button Command="{Binding DataContext.NavigateToTabCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Id}" Value="sep1">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                                                       Foreground="{StaticResource LabelBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource BadgeStyle}"
                                                    Visibility="{Binding BadgeCount, Converter={StaticResource BadgeVisibilityConverter}}">
                                                <TextBlock Text="{Binding BadgeCount, Converter={StaticResource BadgeTextConverter}}"
                                                           Style="{StaticResource BadgeTextStyle}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部用户区 -->
                <Border Grid.Row="3"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource FillBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="28" Height="28"
                                     Fill="{StaticResource AccentDimBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}"
                                           FontWeight="Medium" FontSize="13"
                                           Foreground="{StaticResource LabelBrush}" LineHeight="17"/>
                                <TextBlock Text="{Binding CurrentBranchName}"
                                           FontSize="11"
                                           Foreground="{StaticResource TertiaryLabelBrush}" LineHeight="15"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                     ToolTip="{Binding SyncStatusText}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingSyncCount}" Value="1">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ManualSyncCommand}"
                                    Style="{StaticResource UserActionButtonStyle}" ToolTip="手动同步">
                                <TextBlock Text="同步" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}" HorizontalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding LogoutCommand}"
                                    Style="{StaticResource UserActionButtonStyle}" ToolTip="退出登录">
                                <TextBlock Text="退出" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 主内容区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标签栏 -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,0">
                <DockPanel LastChildFill="False">
                    <ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TabItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="tabRoot" Background="Transparent"
                                            Padding="0" CornerRadius="8,8,0,0" Margin="1,0" Cursor="Hand"
                                            MouseLeftButtonUp="TabBorder_MouseLeftButtonUp" MinWidth="100">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{StaticResource TertiaryLabelBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Margin="12,0,4,0"/>
                                            <Button Grid.Column="1" Content="×"
                                                    Visibility="{Binding IsClosable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButtonStyle}" FontSize="14"
                                                    Foreground="{StaticResource QuaternaryLabelBrush}" 
                                                    Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="tabRoot" Property="Background"
                                                    Value="{StaticResource ContentBackgroundBrush}"/>
                                            <Setter TargetName="tabRoot" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="tabRoot" Property="BorderThickness"
                                                    Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                        <Button ToolTip="刷新 (F5)" Command="{Binding RefreshCurrentTabCommand}"
                                Style="{StaticResource IconButtonStyle}">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <materialDesign:TransitioningContent Content="{Binding SelectedTab.ViewModel}" Margin="0"/>
                <controls:LoadingOverlay x:Name="LoadingCtrl"
                                         Panel.ZIndex="100"
                                         Message="加载中..."
                                         IsActive="{Binding SelectedTab.ViewModel.IsLoading}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

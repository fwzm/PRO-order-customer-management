<UserControl x:Class="PRO.Desktop.Views.EmployeeListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:PRO.Desktop.Controls"
        mc:Ignorable="d"
        d:DesignHeight="700" d:DesignWidth="1000"
        Background="{StaticResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TertiaryLabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="组织架构" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" Width="200"
                         materialDesign:HintAssist.Hint="搜索工号/姓名..."/>
                <Button Content="搜索" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="部门管理" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ToggleDepartmentPanelCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="新增员工" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewEmployeeCommand}" Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- 部门管理面板 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding IsDepartmentPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="部门管理" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <DataGrid ItemsSource="{Binding Departments}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" RowHeight="36" MaxHeight="200" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="部门名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60"/>
                        <DataGridTemplateColumn Header="操作" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="编辑" Padding="6,2" FontSize="11"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditDepartmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" Padding="6,2" FontSize="11"
                                                Foreground="{StaticResource ErrorBrush}"
                                                Style="{StaticResource PlainButtonStyle}"
                                                Command="{Binding DataContext.DeleteDepartmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox Text="{Binding NewDepartmentName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" Width="160"
                             materialDesign:HintAssist.Hint="部门名称"/>
                    <TextBox Text="{Binding NewDepartmentSortOrder, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" Width="80" Margin="8,0"
                             materialDesign:HintAssist.Hint="排序"/>
                    <Button Content="新增部门" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddDepartmentCommand}" Padding="12,7" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 员工列表 -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="工号" Binding="{Binding EmployeeNo}" Width="100"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="部门" Binding="{Binding DepartmentName}" Width="120"/>
                <DataGridTextColumn Header="分公司" Binding="{Binding BranchName}" Width="120"/>
                <DataGridTextColumn Header="角色" Binding="{Binding RoleName}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="80"/>
                <DataGridTemplateColumn Header="操作" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑" Padding="8,4" FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="删除" Padding="8,4" FontSize="11"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Style="{StaticResource PlainButtonStyle}"
                                        Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyStateControl Grid.Row="3" DataContext="{Binding EmptyState}"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>

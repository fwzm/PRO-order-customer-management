<UserControl x:Class="PRO.Desktop.Views.AuditTrailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Text="审计日志" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" Width="200"
                         materialDesign:HintAssist.Hint="搜索操作内容/用户"/>

                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableEntityTypes}"
                          SelectedItem="{Binding FilterEntityType}"
                          Width="120" materialDesign:HintAssist.Hint="实体类型"/>

                <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableActions}"
                          SelectedItem="{Binding FilterAction}"
                          Width="120" materialDesign:HintAssist.Hint="操作"/>

                <DatePicker Grid.Column="6" SelectedDate="{Binding FilterStartDate}"
                            Width="130" materialDesign:HintAssist.Hint="开始日期"/>

                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Content="搜索" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SearchCommand}" Padding="10,6" Margin="0,0,4,0"/>
                    <Button Content="清除" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFilterCommand}" Padding="10,6" Margin="0,0,4,0"/>
                    <Button Content="导出" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCommand}" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 审计日志列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="{StaticResource SurfaceBrush}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="100"/>
                <DataGridTextColumn Header="实体" Binding="{Binding EntityType}" Width="80"/>
                <DataGridTextColumn Header="实体ID" Binding="{Binding EntityId}" Width="70"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="80"/>
                <DataGridTextColumn Header="旧值" Binding="{Binding OldValue}" Width="150"/>
                <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="150"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 空状态 -->
        <controls:EmptyStateControl Grid.Row="2" DataContext="{Binding EmptyState}"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- 分页 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <Run Text="共 "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" 条记录"/>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="上一页" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PreviousPageCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0">
                        <Run Text="{Binding PageIndex}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding ComputedTotalPages}"/>
                    </TextBlock>
                    <Button Content="下一页" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NextPageCommand}" Padding="8,4" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

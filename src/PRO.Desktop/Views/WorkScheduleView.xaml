<UserControl x:Class="PRO.Desktop.Views.WorkScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="工作计划" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Employees}" 
                              SelectedItem="{Binding SelectedEmployee, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              Width="150" Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="选择员工"/>
                    
                    <Button Content="新建排班" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding CreateScheduleCommand}" Margin="0,0,8,0"/>
                    <Button Content="新建计划" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CreatePlanCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日历视图 -->
        <Grid Grid.Row="1" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 日历 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="&lt;" Command="{Binding PreviousMonthCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="SemiBold">
                            <Run Text="{Binding SelectedYear}"/>
                            <Run Text="年"/>
                            <Run Text="{Binding SelectedMonth}"/>
                            <Run Text="月"/>
                        </TextBlock>
                        
                        <Button Grid.Column="2" Content="&gt;" Command="{Binding NextMonthCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                    </Grid>

                    <!-- 星期标题 -->
                    <UniformGrid Rows="1" Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="日" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="一" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="二" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="三" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="四" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="五" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="六" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    </UniformGrid>

                    <!-- 日期网格 -->
                    <ItemsControl ItemsSource="{Binding CalendarItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="dayBorder" BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0.5" Padding="4" MinHeight="60"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="DayBorder_MouseLeftButtonUp">
                                    <StackPanel>
                                        <TextBlock x:Name="dayText" Text="{Binding Date.Day}" 
                                                   FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="workTimeText" FontSize="10" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsWorkday, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}-{1}">
                                                    <Binding Path="WorkStartTime"/>
                                                    <Binding Path="WorkEndTime"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Border x:Name="changedIndicator" Width="6" Height="6" 
                                                CornerRadius="3" Background="{StaticResource WarningBrush}"
                                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                                Visibility="{Binding HasChanged, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Date.DayOfWeek}" Value="Saturday">
                                        <Setter TargetName="dayText" Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Date.DayOfWeek}" Value="Sunday">
                                        <Setter TargetName="dayText" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorkday}" Value="True">
                                        <Setter TargetName="dayBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 日计划详情 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16">
                            <Run Text="{Binding SelectedDate, StringFormat=yyyy年MM月dd日}"/>
                            <Run Text="工作计划"/>
                        </TextBlock>

                        <!-- 排班信息 -->
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="今日排班" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Visibility="{Binding CurrentDailyPlan.Schedule, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Run Text="工作时间："/>
                                    <Run Text="{Binding CurrentDailyPlan.Schedule.WorkStartTime, StringFormat=hh\\:mm, FallbackValue=--}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding CurrentDailyPlan.Schedule.WorkEndTime, StringFormat=hh\\:mm, FallbackValue=--}"/>
                                </TextBlock>
                                <TextBlock Text="今日工时：" Margin="0,4,0,0"
                                           Visibility="{Binding CurrentDailyPlan.Schedule, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Run Text="{Binding CurrentDailyPlan.TotalWorkMinutes, FallbackValue=0}"/>
                                    <Run Text="分钟"/>
                                </TextBlock>
                                <TextBlock Text="今日休息" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding CurrentDailyPlan.Schedule, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </StackPanel>
                        </Border>

                        <!-- 计划列表 -->
                        <TextBlock Text="详细计划" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding CurrentDailyPlan.Plans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" 
                                            Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" 
                                                    Padding="8,4" VerticalAlignment="Top">
                                                <TextBlock Foreground="White" FontSize="11">
                                                    <Run Text="{Binding StartTimeStr}"/>
                                                    <Run Text="-"/>
                                                    <Run Text="{Binding EndTimeStr}"/>
                                                </TextBlock>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="11" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="暂无计划" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Visibility="{Binding CurrentDailyPlan.Plans.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 周视图 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="24,0,24,16">
            <StackPanel>
                <TextBlock Text="本周排班概览" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <Grid Grid.Column="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WeekStartDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="~ 周日" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}" VerticalAlignment="Center"/>
                </Grid>
                <DataGrid ItemsSource="{Binding WeeklyScheduleRows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="员工" Binding="{Binding EmployeeName}" Width="100"/>
                        <DataGridTextColumn Header="一" Binding="{Binding DayMon}" Width="*"/>
                        <DataGridTextColumn Header="二" Binding="{Binding DayTue}" Width="*"/>
                        <DataGridTextColumn Header="三" Binding="{Binding DayWed}" Width="*"/>
                        <DataGridTextColumn Header="四" Binding="{Binding DayThu}" Width="*"/>
                        <DataGridTextColumn Header="五" Binding="{Binding DayFri}" Width="*"/>
                        <DataGridTextColumn Header="六" Binding="{Binding DaySat}" Width="*"/>
                        <DataGridTextColumn Header="日" Binding="{Binding DaySun}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

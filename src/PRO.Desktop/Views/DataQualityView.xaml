<UserControl x:Class="PRO.Desktop.Views.DataQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             Background="{StaticResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="数据质量检测" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="重新检测" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding GenerateReportCommand}" Margin="16,0,0,0" Padding="12,6"/>
            </StackPanel>

            <!-- 空状态（检测未执行） -->
            <controls:EmptyStateControl DataContext="{Binding EmptyState}"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- 总体评分 -->
            <Border Style="{StaticResource AppleCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 评分圆环 -->
                    <Border Grid.Column="0" Width="120" Height="120" Margin="0,0,24,0">
                        <Grid>
                            <Ellipse Stroke="{StaticResource FillBrush}" StrokeThickness="8"/>
                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="8"
                                     StrokeDashArray="251.2" 
                                     StrokeDashOffset="{Binding OverallScore, Converter={StaticResource ScoreToDashOffsetConverter}}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OverallScore}" FontSize="32" FontWeight="Bold" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding OverallLevel}" FontSize="12" 
                                           Foreground="{StaticResource TertiaryLabelBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 评分说明 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OverallDescription}" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="检测时间：加载后显示" FontSize="12" 
                                   Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分项评分 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 客户质量 -->
                <Border Grid.Column="0" Style="{StaticResource AppleCardStyle}">
                    <StackPanel>
                        <TextBlock Text="客户数据" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CustomerScore}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CustomerLevel}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="重复客户："/><Run Text="{Binding DuplicateCustomerCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="空手机号："/><Run Text="{Binding EmptyPhoneCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="空地址："/><Run Text="{Binding EmptyAddressCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="长期未下单："/><Run Text="{Binding InactiveCustomerCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 订单质量 -->
                <Border Grid.Column="2" Style="{StaticResource AppleCardStyle}">
                    <StackPanel>
                        <TextBlock Text="订单数据" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OrderScore}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding OrderLevel}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="过期草稿："/><Run Text="{Binding StaleDraftCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="长期待分配："/><Run Text="{Binding LongPendingCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="已完成未结算："/><Run Text="{Binding UnsettledCompletedCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 产品质量 -->
                <Border Grid.Column="4" Style="{StaticResource AppleCardStyle}">
                    <StackPanel>
                        <TextBlock Text="产品数据" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProductScore}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ProductLevel}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="重复SKU："/><Run Text="{Binding DuplicateSkuCount}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                <Run Text="负库存："/><Run Text="{Binding NegativeStockCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 重复客户详情 -->
            <Border Style="{StaticResource AppleCardStyle}">
                <StackPanel>
                    <TextBlock Text="重复客户列表" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="匹配类型："/><Run Text="{Binding MatchType}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}">
                                                <Run Text="匹配值："/><Run Text="{Binding MatchValue}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Customers}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="12">
                                                            <Run Text="- "/>
                                                            <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding Phone}"/>
                                                            <Run Text=" 订单:"/>
                                                            <Run Text="{Binding OrderCount}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="合并" 
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.MergeDuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="8,4" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

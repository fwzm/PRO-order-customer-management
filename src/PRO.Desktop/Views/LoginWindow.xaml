<Window x:Class="PRO.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="PRO 企业管理系统"
        Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="20" Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource FillBrush}" BorderThickness="1"
            Effect="{StaticResource AppleShadowMedium}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="320"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部品牌区 -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="20,20,0,60"
                    Panel.ZIndex="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PRO" FontSize="72" FontWeight="Thin" Foreground="White" HorizontalAlignment="Center"
                               Opacity="0.95"/>
                    <TextBlock Text="企业管理系统" FontSize="18" Foreground="#DDFFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 关闭按钮（在品牌区之上） -->
            <Button Content="✕" Width="36" Height="36" FontSize="16" Padding="0"
                    Background="#33FFFFFF" BorderThickness="0" Foreground="White"
                    Panel.ZIndex="10"
                    Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                    Click="CloseButton_Click" FontFamily="Segoe UI">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="18" Width="36" Height="36"
                                            RenderTransformOrigin="0.5,0.5">
                                        <TextBlock Text="✕" FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="#66FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <!-- 最小化按钮（在品牌区之上） -->
            <Button Content="─" Width="36" Height="36" FontSize="16" Padding="0"
                    Background="#33FFFFFF" BorderThickness="0" Foreground="White"
                    Panel.ZIndex="10"
                    Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,56,0"
                    Click="MinimizeButton_Click" FontFamily="Segoe UI">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="18" Width="36" Height="36"
                                            RenderTransformOrigin="0.5,0.5">
                                        <TextBlock Text="─" FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="#66FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 登录表单 -->
            <StackPanel Grid.Row="1" Margin="44,28,44,36" VerticalAlignment="Top">
                <TextBlock Text="登录" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}"
                           Margin="0,0,0,28"/>

                <TextBlock Text="工号" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtEmployeeNo" Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         materialDesign:HintAssist.Hint="请输入工号"
                         Padding="12,9" FontSize="13" Margin="0,0,0,14"
                         KeyDown="txtEmployeeNo_KeyDown"/>

                <TextBlock Text="密码" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             PasswordChanged="txtPassword_PasswordChanged"
                             Padding="12,9" FontSize="13" Margin="0,0,0,14"
                             KeyDown="txtPassword_KeyDown">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="{StaticResource FillBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Background" Value="{StaticResource ContentBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
                            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- 记住我 -->
                <CheckBox Content="记住工号" IsChecked="{Binding RememberMe}" Margin="0,0,0,6"
                          Foreground="{StaticResource TertiaryLabelBrush}" FontSize="13"/>

                <!-- 错误信息 -->
                <TextBlock Text="{Binding LoginError}" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                           Visibility="{Binding LoginError, Converter={StaticResource NullToVisibilityConverter}}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <!-- 分隔线 -->
                <Rectangle Height="1" Fill="{StaticResource FillBrush}" Margin="0,20,0,20"/>

                <!-- 登录按钮 -->
                <Button Content="{Binding IsLoggingIn, Converter={StaticResource BoolToLoginTextConverter}}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Height="50" FontSize="16" FontWeight="Medium"/>

                <!-- 版本 -->
                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource QuaternaryLabelBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

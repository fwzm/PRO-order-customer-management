<UserControl x:Class="PRO.Desktop.Views.ReportCenterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="报表中心" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="基于您业务数据的实时图表分析" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="⟳ 刷新" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Padding="16,7" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,16,0,0" MinHeight="360">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0" MinWidth="300">
                    <StackPanel><TextBlock Text="月营业额趋势" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding RevenueSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="300" MinHeight="200"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0" MinWidth="300">
                    <StackPanel><TextBlock Text="产品销售排行" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding ProductSeries}" XAxes="{Binding ProductXAxes}" YAxes="{Binding ProductYAxes}" Height="300" MinHeight="200"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="PRO.Desktop.Views.CustomerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="选择客户"
        Height="500" Width="500"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <TextBox Grid.Row="0" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                 Style="{StaticResource ModernTextBoxStyle}"
                 materialDesign:HintAssist.Hint="搜索客户名称或电话..."
                 Margin="0,0,0,12"/>

        <!-- 客户列表 -->
        <DataGrid Grid.Row="1" x:Name="CustomerGrid"
                  AutoGenerateColumns="False"
                  Style="{StaticResource DataGridStyle}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="CustomerGrid_SelectionChanged"
                  MouseDoubleClick="CustomerGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="客户名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="客户编号" Binding="{Binding CustomerNo}" Width="90"/>
                <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="100"/>
                <DataGridTextColumn Header="担当" Binding="{Binding CustomerManagerName}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                    Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button Content="选择" Style="{StaticResource PrimaryButtonStyle}"
                    Click="SelectButton_Click" x:Name="SelectButton" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

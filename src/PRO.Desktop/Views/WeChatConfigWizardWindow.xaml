<Window x:Class="PRO.Desktop.Views.WeChatConfigWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="企业微信配置向导"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧步骤导航 -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <TextBlock Text="配置向导" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource LabelBrush}" Margin="0,0,0,24"/>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                    Cursor="Hand" MouseLeftButtonDown="Step_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 步骤图标 -->
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                            Background="{StaticResource FillBrush}">
                                        <TextBlock Text="{Binding Step, Converter={StaticResource StepNumberConverter}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- 步骤标题 -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryLabelBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <!-- 步骤0: 欢迎 -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Welcome}">
                    <TextBlock Text="欢迎使用企业微信配置向导" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource LabelBrush}"/>
                    <TextBlock Text="本向导将引导您完成企业微信与PRO系统的集成配置。" FontSize="14"
                               Foreground="{StaticResource SecondaryLabelBrush}" Margin="0,12,0,32"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="配置前准备" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="1. 已注册企业微信" Margin="0,0,0,8"/>
                            <TextBlock Text="2. 已在企业微信后台创建应用" Margin="0,0,0,8"/>
                            <TextBlock Text="3. 已获取企业ID（CorpId）" Margin="0,0,0,8"/>
                            <TextBlock Text="4. 已获取应用Secret" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <Button Content="开始配置" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NextStepCommand}" Margin="0,24,0,0"
                            HorizontalAlignment="Left" Padding="32,10"/>
                </StackPanel>

                <!-- 步骤1: 创建应用 -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CreateApp}">
                    <TextBlock Text="创建企业微信应用" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="请在企业微信管理后台创建应用" FontSize="14"
                               Foreground="{StaticResource SecondaryLabelBrush}" Margin="0,8,0,24"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="操作步骤" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="1. 登录企业微信管理后台 (work.weixin.qq.com)" Margin="0,0,0,8"/>
                            <TextBlock Text="2. 进入「应用管理」→「自建」" Margin="0,0,0,8"/>
                            <TextBlock Text="3. 点击「创建应用」" Margin="0,0,0,8"/>
                            <TextBlock Text="4. 填写应用信息：" Margin="0,0,0,8"/>

                            <Grid Margin="20,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="应用名称：" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AppName}"
                                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="应用描述：" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AppDescription}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </Grid>

                            <TextBlock Text="5. 设置应用可见范围" Margin="0,0,0,8"/>
                            <TextBlock Text="6. 记录「AgentId」" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="上一步" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PreviousStepCommand}" Margin="0,0,8,0" Padding="24,8"/>
                        <Button Content="下一步" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NextStepCommand}" Padding="24,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤2: 配置凭证 -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ConfigureCredentials}">
                    <TextBlock Text="配置应用凭证" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="请输入企业微信应用的凭证信息" FontSize="14"
                               Foreground="{StaticResource SecondaryLabelBrush}" Margin="0,8,0,24"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="企业ID" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CorpId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="ww1234567890abcdef"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用Secret" VerticalAlignment="Center"/>
                                <PasswordBox Grid.Column="1" x:Name="txtCorpSecret"
                                             PasswordChanged="CorpSecret_PasswordChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用ID" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding AgentId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="1000002"/>
                            </Grid>

                            <Button Content="测试连接" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"/>

                            <!-- 测试结果 -->
                            <Border Margin="0,12,0,0" Visibility="{Binding ConnectionTestResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionTestResult.Success}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Padding="12" Text="{Binding ConnectionTestResult.ErrorMessage, FallbackValue='连接成功！'}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="上一步" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PreviousStepCommand}" Margin="0,0,8,0" Padding="24,8"/>
                        <Button Content="下一步" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NextStepCommand}" Padding="24,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤6: 完成 -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Complete}">
                    <TextBlock Text="配置完成！" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="企业微信集成配置已完成。" FontSize="14"
                               Foreground="{StaticResource SecondaryLabelBrush}" Margin="0,12,0,32"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="已配置功能" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="✅ 应用凭证已配置" Margin="0,0,0,8"/>
                            <TextBlock Text="✅ 消息回调已验证" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SyncedEmployeeCount, StringFormat='✅ 通讯录已同步 {0} 名员工'}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SyncedCustomerCount, StringFormat='✅ 客户数据已同步 {0} 个'}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <Button Content="完成" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CompleteWizardCommand}" Margin="0,24,0,0"
                            HorizontalAlignment="Left" Padding="32,10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<Window x:Class="PRO.Desktop.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="820"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,24,24,0">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="查看模式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>

                <!-- ========== 客户信息 ========== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="客户信息" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="{StaticResource FillBrush}" BorderThickness="1" CornerRadius="8"
                                    Background="{StaticResource ContentBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             materialDesign:HintAssist.Hint="输入客户名称或编号搜索..."
                                             IsReadOnly="{Binding IsReadOnly}"/>
                                    <Button Grid.Column="1" Content="📋" 
                                            Style="{StaticResource PlainButtonStyle}"
                                            ToolTip="打开客户选择器"
                                            Command="{Binding OpenCustomerPickerCommand}"
                                            FontSize="16"
                                            Padding="6,4"
                                            Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ListBox ItemsSource="{Binding CustomerSearchResults}"
                                 Visibility="{Binding HasCustomerSearchResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                 MaxHeight="150"
                                 BorderBrush="{StaticResource FillBrush}"
                                 Background="{StaticResource ContentBackgroundBrush}"
                                 Margin="0,0,0,8"
                                 SelectionChanged="CustomerSearchList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerNo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0"
                                Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="手机：" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerPhone}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 产品明细 ========== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="产品明细" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                                  Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MaxHeight="400"
                                  IsReadOnly="{Binding IsReadOnly}"
                                  RowEditEnding="ProductGrid_RowEditEnding">
                            <DataGrid.InputBindings>
                                <KeyBinding Gesture="Ctrl+N" Command="{Binding AddItemCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="产品" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding ProductId}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      IsReadOnly="False" IsEditable="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Style" Value="{StaticResource ModernTextBoxStyle}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=¥{0:N2}}" Width="80">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Style" Value="{StaticResource ModernTextBoxStyle}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="小计" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="80" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="优惠" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="▼"
                                                    Click="DiscountButton_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource PlainButtonStyle}"
                                                    FontSize="9"
                                                    Padding="4,2"
                                                    Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PlainButtonStyle}"
                                                    Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 快速添加区域 -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <ComboBox ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="Name"
                                      Width="200"
                                      IsEditable="True"
                                      materialDesign:HintAssist.Hint="选择产品"
                                      Margin="0,0,8,0"/>
                            <TextBox Text="{Binding AddQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="数量"
                                     Margin="0,0,8,0"/>
                            <Button Content="添加" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddItemCommand}" Padding="16,6"/>
                        </StackPanel>

                        <!-- 总计 -->
                        <Border Grid.Row="3" Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="12" Margin="0,12,0,0"
                                Visibility="{Binding Items.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="订单总金额" Foreground="White" FontSize="11"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:N2}}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 收款信息 ========== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="收款信息" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="订单总金额：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalAmount, StringFormat=¥{0:N2}}" 
                                     Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="3" Text="优惠金额：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding DiscountAmount, StringFormat=¥{0:N2}, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="{Binding IsReadOnly}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="应收金额：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ReceivableAmount, StringFormat=¥{0:N2}}" 
                                     Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="3" Text="收款金额：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding ReceivedAmount, StringFormat=¥{0:N2}}" 
                                     Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="{Binding IsReadOnly}"/>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="收款状态：" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding PaymentStatus}" 
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
                                <ComboBoxItem Content="未收款" Tag="Unpaid"/>
                                <ComboBoxItem Content="部分收款" Tag="Partial"/>
                                <ComboBoxItem Content="已收款" Tag="Paid"/>
                                <ComboBoxItem Content="移交法务" Tag="Legal"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== 备注 ========== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,16">
                    <StackPanel>
                        <TextBlock Text="备注" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="60"
                                 IsReadOnly="{Binding IsReadOnly}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                                    Click="CancelButton_Click" Margin="0,0,8,0" Padding="24,9"/>
                            <Button Content="保存草稿" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SaveAsDraftCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}" Padding="24,9"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <Button Content="关闭" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CancelButton_Click" Padding="24,9"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

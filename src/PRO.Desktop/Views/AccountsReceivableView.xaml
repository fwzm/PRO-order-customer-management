<UserControl x:Class="PRO.Desktop.Views.AccountsReceivableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="应收账款" Style="{StaticResource PageTitleStyle}"/><TextBlock FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,2,0,12">
            <Run Text="超过15天未收款的订单将进入预警"/></TextBlock></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0"><StackPanel><TextBlock Text="应收回款" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalReceivable, StringFormat=¥{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="30天以上" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalOverdue30, StringFormat=¥{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="#F39C12"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="60天以上" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalOverdue60, StringFormat=¥{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="#E67E22"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,0,0"><StackPanel><TextBlock Text="90天以上" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalOverdue90, StringFormat=¥{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" MaxWidth="300" materialDesign:HintAssist.Hint="搜索订单号/客户名称/客户担当"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SearchCommand}" Padding="14,6" Margin="8,0"/>
        </Grid>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="140"/>
                <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="120"/>
                <DataGridTextColumn Header="客户担当" Binding="{Binding CustomerManagerName}" Width="100"/>
                <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount, StringFormat=¥{0:N2}}" Width="80"/>
                <DataGridTextColumn Header="已收款" Binding="{Binding ReceivedAmount, StringFormat=¥{0:N2}}" Width="80"/>
                <DataGridTextColumn Header="未收款" Binding="{Binding UnpaidAmount, StringFormat=¥{0:N2}}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E74C3C"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="天数" Binding="{Binding DaysOverdue}" Width="50"/>
                <DataGridTextColumn Header="账龄" Binding="{Binding StatusBadge}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="{Binding StatusColor}"/><Setter Property="Padding" Value="6,2"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="创建" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd}}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl x:Class="PRO.Desktop.Views.BusinessDistrictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="商圈管理" Style="{StaticResource PageTitleStyle}"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="商圈列表" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新增商圈" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"
                                    Command="{Binding NewBusinessDistrictCommand}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Style="{StaticResource DataGridStyle}" IsReadOnly="True" MaxHeight="400"
                              ItemsSource="{Binding BusinessDistricts}"
                              SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="商圈名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="所在城市" Binding="{Binding City}" Width="120"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTemplateColumn Header="操作" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Padding="6,2" FontSize="11"
                                                    Foreground="{StaticResource ErrorBrush}" Style="{StaticResource PlainButtonStyle}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 编辑/新增表单 -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Margin="0,16,0,0" Padding="16" Background="{StaticResource BackgroundBrush}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" MaxLength="50"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="城市：" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Cities}"
                                          SelectedItem="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}"
                                          materialDesign:HintAssist.Hint="选择城市"
                                          IsEditable="True"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding CancelEditCommand}" Margin="0,0,8,0" Padding="16,8"/>
                                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

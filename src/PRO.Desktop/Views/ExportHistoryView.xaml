<UserControl x:Class="PRO.Desktop.Views.ExportHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:PRO.Desktop.Controls"
        mc:Ignorable="d"
        d:DesignHeight="700" d:DesignWidth="1000"
        Background="{StaticResource ContentBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="导出历史" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" Width="200"
                         materialDesign:HintAssist.Hint="搜索文件名/操作人..."/>
                <Button Content="搜索" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}" Padding="14,8"/>
        </Grid>

        <!-- 筛选标签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="全部" IsChecked="True" Style="{StaticResource FilterTabStyle}"
                         Command="{Binding FilterByTypeCommand}" CommandParameter="{x:Null}"/>
            <RadioButton Content="客户" Style="{StaticResource FilterTabStyle}"
                         Command="{Binding FilterByTypeCommand}" CommandParameter="Customer"/>
            <RadioButton Content="订单" Style="{StaticResource FilterTabStyle}"
                         Command="{Binding FilterByTypeCommand}" CommandParameter="Order"/>
            <RadioButton Content="产品" Style="{StaticResource FilterTabStyle}"
                         Command="{Binding FilterByTypeCommand}" CommandParameter="Product"/>
            <RadioButton Content="配送" Style="{StaticResource FilterTabStyle}"
                         Command="{Binding FilterByTypeCommand}" CommandParameter="Delivery"/>
        </StackPanel>

        <!-- 数据表格 -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" RowHeight="40" IsReadOnly="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding ExportType}" Width="80"/>
                    <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="60"/>
                    <DataGridTextColumn Header="记录数" Binding="{Binding RecordCount}" Width="70"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="70"/>
                    <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="80"/>
                    <DataGridTextColumn Header="导出时间" Binding="{Binding ExportTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                    <DataGridTemplateColumn Header="操作" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="下载" Padding="8,4" FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="删除" Padding="8,4" FontSize="11"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Style="{StaticResource PlainButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyStateControl DataContext="{Binding EmptyState}"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>

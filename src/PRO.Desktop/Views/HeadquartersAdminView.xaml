<UserControl x:Class="PRO.Desktop.Views.HeadquartersAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:PRO.Domain.Enums;assembly=PRO.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="总部管理" Style="{StaticResource PageTitleStyle}"/>

            <!-- TabControl -->
            <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" Margin="0,16,0,0">
                
                <!-- 企业微信配置 -->
                <TabItem Header="企业微信">
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="企业微信配置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            
                            <!-- 启用开关 -->
                            <CheckBox Content="启用企业微信功能" IsChecked="{Binding IsWeChatEnabled}" Margin="0,0,0,16"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="企业ID：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                         Text="{Binding WeChatCorpId, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsWeChatHardcoded}"
                                         IsEnabled="{Binding IsWeChatEnabled}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用Secret：" VerticalAlignment="Center"/>
                                <PasswordBox Grid.Column="1" materialDesign:HintAssist.Hint="输入应用Secret"
                                              IsEnabled="{Binding IsWeChatEnabled}"
                                              materialDesign:PasswordBoxAssist.Password="{Binding WeChatCorpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用ID：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                         Text="{Binding WeChatAgentId, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsWeChatHardcoded}"
                                         IsEnabled="{Binding IsWeChatEnabled}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认Webhook：" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                         Text="{Binding WeChatWebhookUrl, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsWeChatEnabled}"/>
                            </Grid>
                            
                            <!-- 连接状态 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                <Button Content="保存配置" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding SaveWeChatConfigCommand}" Margin="0,0,8,0"/>
                                <Button Content="测试连接" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding TestWeChatConnectionCommand}"
                                        IsEnabled="{Binding IsWeChatEnabled}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding WeChatStatus}" 
                                           VerticalAlignment="Center"
                                           Foreground="{Binding IsWeChatConnected, Converter={StaticResource BoolToStatusColorConverter}}"/>
                            </StackPanel>
                            
                            <!-- 组织架构同步 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                    CornerRadius="4" Padding="16"
                                    Background="{StaticResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="组织架构同步" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="将企业微信通讯录同步到本地系统" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="立即同步组织架构" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SyncOrganizationCommand}"
                                                IsEnabled="{Binding IsWeChatConnected}" Margin="0,0,8,0"/>
                                        <Button Content="同步企业微信联系人" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding PullWeChatCustomersCommand}"
                                                IsEnabled="{Binding IsWeChatConnected}"
                                                ToolTip="将企业微信外部联系人拉取到本系统客户列表"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Webhook管理 -->
                <TabItem Header="Webhook">
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 工具栏 -->
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Webhook管理" FontSize="16" FontWeight="SemiBold"/>
                                <Button Content="新增Webhook" Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Right" Padding="16,8"
                                        Command="{Binding NewWebhookCommand}"/>
                            </Grid>
                            
                            <!-- Webhook 列表 -->
                            <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" IsReadOnly="True" MaxHeight="300"
                                      ItemsSource="{Binding Webhooks}" SelectedItem="{Binding SelectedWebhook}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                                    <DataGridTextColumn Header="URL" Binding="{Binding WebhookUrl}" Width="*"/>
                                    <DataGridTextColumn Header="触发条件" Binding="{Binding TriggerCondition}" Width="120"/>
                                    <DataGridTextColumn Header="最后测试" Binding="{Binding LastTestTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToEnabledConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="编辑" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.EditWebhookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="测试" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.TestWebhookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" Padding="6,2" FontSize="11"
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Style="{StaticResource PlainButtonStyle}"
                                                            Command="{Binding DataContext.DeleteWebhookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <!-- Webhook 编辑表单 -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                    CornerRadius="4" Margin="0,16,0,0" Padding="16"
                                    Background="{StaticResource BackgroundBrush}"
                                    Visibility="{Binding IsEditingWebhook, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Webhook 配置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                                 Text="{Binding NewWebhookName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="URL地址：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                                 Text="{Binding NewWebhookUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="触发条件：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                                  SelectedValue="{Binding NewWebhookTrigger}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部事件" Tag=""/>
                                            <ComboBoxItem Content="订单创建" Tag="order_created"/>
                                            <ComboBoxItem Content="订单已分配" Tag="order_assigned"/>
                                            <ComboBoxItem Content="订单配送中" Tag="order_delivering"/>
                                            <ComboBoxItem Content="订单已完成" Tag="order_completed"/>
                                            <ComboBoxItem Content="订单已取消" Tag="order_cancelled"/>
                                            <ComboBoxItem Content="客户新增" Tag="customer_created"/>
                                            <ComboBoxItem Content="客户更新" Tag="customer_updated"/>
                                            <ComboBoxItem Content="结算完成" Tag="settlement_created"/>
                                            <ComboBoxItem Content="排班变动" Tag="workschedule_changed"/>
                                            <ComboBoxItem Content="同步完成" Tag="sync_completed"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="备注：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" 
                                                 Text="{Binding NewWebhookRemark, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" 
                                                Command="{Binding SaveWebhookCommand}" Margin="0,0,8,0"/>
                                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                                                Command="{Binding CancelWebhookEditCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 数据备份 -->
                <TabItem Header="数据备份">
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="数据备份与恢复" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="手动备份" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding CreateBackupCommand}" Margin="0,0,8,0"/>
                                    <Button Content="清理过期备份" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CleanupBackupCommand}"/>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock Text="系统每30分钟自动备份一次，保留30天备份记录" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                            
                            <DataGrid Style="{StaticResource DataGridStyle}" IsReadOnly="True" MaxHeight="300"
                                      ItemsSource="{Binding BackupRecords}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding BackupType}" Width="80"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding FileSizeStr}" Width="100"/>
                                    <DataGridTextColumn Header="备份时间" Binding="{Binding BackupTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                    <DataGridTextColumn Header="过期时间" Binding="{Binding ExpireTime, StringFormat=yyyy-MM-dd}" Width="120"/>
                                    <DataGridTemplateColumn Header="操作" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="恢复" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Content="删除" Padding="6,2" FontSize="11"
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Style="{StaticResource PlainButtonStyle}"
                                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Id}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- 同步配置 -->
                <TabItem Header="同步配置">
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="同步配置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            
                            <CheckBox Content="启用自动同步" IsChecked="{Binding SyncConfig.AutoSyncEnabled}" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同步间隔：" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SyncIntervalCombo" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                          SelectedIndex="1"
                                          SelectionChanged="SyncInterval_SelectionChanged">
                                    <ComboBoxItem Content="15分钟" Tag="15"/>
                                    <ComboBoxItem Content="30分钟" Tag="30"/>
                                    <ComboBoxItem Content="1小时" Tag="60"/>
                                </ComboBox>
                            </Grid>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="冲突解决策略：" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectedValue="{Binding SyncConfig.ConflictResolution}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="时间优先" Tag="{x:Static enums:ConflictResolution.TimestampFirst}"/>
                                    <ComboBoxItem Content="总部优先" Tag="{x:Static enums:ConflictResolution.HeadquartersFirst}"/>
                                    <ComboBoxItem Content="手动处理" Tag="{x:Static enums:ConflictResolution.Manual}"/>
                                </ComboBox>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding SaveSyncConfigCommand}" Margin="0,0,8,0"/>
                                <Button Content="立即同步" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SyncNowCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- 操作日志 -->
                <TabItem Header="操作日志">
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="操作日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            
                            <DataGrid Style="{StaticResource DataGridStyle}" IsReadOnly="True" MaxHeight="400"
                                      ItemsSource="{Binding OperationLogs}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100"/>
                                    <DataGridTextColumn Header="工号" Binding="{Binding OperatorNo}" Width="80"/>
                                    <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="80"/>
                                    <DataGridTextColumn Header="操作" Binding="{Binding OperationType}" Width="100"/>
                                    <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
                                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="80"/>
                                    <DataGridTextColumn Header="时间" Binding="{Binding OperatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

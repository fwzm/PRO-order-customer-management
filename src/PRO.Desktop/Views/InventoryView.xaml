<UserControl x:Class="PRO.Desktop.Views.InventoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:PRO.Desktop.Controls"
        mc:Ignorable="d" Background="{StaticResource ContentBackgroundBrush}">

    <TabControl Style="{StaticResource AppleSegmentedTabStyle}" Margin="12">
        <TabItem Header="库存管理">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" MaxWidth="200" materialDesign:HintAssist.Hint="搜索..."/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Width="120" Margin="8,0" materialDesign:HintAssist.Hint="选择仓库"/>
                    <Button Grid.Column="2" Content="搜索" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SearchCommand}" Padding="14,6" Margin="8,0"/>
                    <Button Grid.Column="3" Content="开始盘点" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCheckCommand}" Padding="14,6"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100"/>
                        <DataGridTextColumn Header="系统库存" Binding="{Binding SystemStock}" Width="80"/>
                        <DataGridTemplateColumn Header="实际库存" Width="100" Visibility="{Binding DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding ActualStock, UpdateSourceTrigger=PropertyChanged}" Width="70"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="差异" Binding="{Binding VarianceText}" Width="60" Visibility="{Binding DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="仓库" Binding="{Binding WarehouseName}" Width="100"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:EmptyStateControl Grid.Row="1" DataContext="{Binding EmptyState}"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <StackPanel Grid.Row="1" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,12">
                    <TextBox Text="{Binding CheckRemark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="200" materialDesign:HintAssist.Hint="备注" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCheckCommand}" Margin="0,0,8,0" Padding="16,6"/><Button Content="提交盘点" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitCheckCommand}" Padding="16,6"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="补货建议">
            <DataGrid ItemsSource="{Binding ReplenishItems}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" Margin="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="当前库存" Binding="{Binding CurrentStock}" Width="70"/>
                    <DataGridTextColumn Header="预测需求" Binding="{Binding PredictedDemand, StringFormat={}{0:N0}}" Width="70"/>
                    <DataGridTextColumn Header="建议补货" Binding="{Binding SuggestedReplenish}" Width="70">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E74C3C"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat={}{0:N0}%}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
        <TabItem Header="仓库管理">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="150" materialDesign:HintAssist.Hint="仓库名称"/>
                    <TextBox Text="{Binding NewWarehouseAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="200" Margin="8,0" materialDesign:HintAssist.Hint="仓库地址"/>
                    <Button Content="新增" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddWarehouseCommand}" Padding="14,6" Margin="8,0"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="编辑" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                Command="{Binding DataContext.EditWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                        <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                Foreground="#E74C3C"
                                                Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl x:Class="PRO.Desktop.Views.WeChatCustomerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="900"
        Background="{StaticResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TertiaryLabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="企业微信客户" Style="{StaticResource PageTitleStyle}"/>

        <!-- Tab 切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Style="{StaticResource FilterTabStyle}"
                         IsChecked="{Binding IsUnlinkedTab, Converter={StaticResource NullToBoolConverter}}"
                         GroupName="WeChatTab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="未关联"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8"
                            Padding="6,1" Margin="6,0,0,0">
                        <TextBlock Text="{Binding UnlinkedCount}" Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabStyle}"
                         IsChecked="{Binding IsLinkedTab, Converter={StaticResource NullToBoolConverter}}"
                         GroupName="WeChatTab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="已关联"/>
                    <Border Background="{StaticResource FillBrush}" CornerRadius="8"
                            Padding="6,1" Margin="6,0,0,0">
                        <TextBlock Text="{Binding LinkedCount}" Foreground="{StaticResource TertiaryLabelBrush}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabStyle}"
                         IsChecked="{Binding IsUnidentifiableTab, Converter={StaticResource NullToBoolConverter}}"
                         GroupName="WeChatTab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="无法识别"/>
                    <Border Background="#FFF0C0" CornerRadius="8"
                            Padding="6,1" Margin="6,0,0,0">
                        <TextBlock Text="{Binding UnidentifiableCount}" Foreground="#996600" FontSize="11"/>
                    </Border>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- 搜索栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     materialDesign:HintAssist.Hint="搜索客户名称或添加人..."/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchCommand}" Padding="16,7" Margin="8,0"/>

            <!-- 无法识别Tab的批量分配 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <ComboBox ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          Width="150"
                          materialDesign:HintAssist.Hint="选择分公司"/>
                <Button Content="批量分配" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AssignAllUnidentifiableCommand}" Padding="12,7" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 客户列表 -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Customers}"
                  SelectedItem="{Binding SelectedCustomer}"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="44">
            <DataGrid.Columns>
                <DataGridTextColumn Header="客户名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="添加人" Binding="{Binding AddUserName}" Width="80"/>
                <DataGridTextColumn Header="所属部门" Binding="{Binding AddUserDepartmentName}" Width="100"/>
                <DataGridTextColumn Header="关联客户" Binding="{Binding LinkedCustomerName}" Width="*"/>
                <DataGridTextColumn Header="客户编号" Binding="{Binding CustomerNoInDesc}" Width="100"/>
                <DataGridTextColumn Header="归属分公司" Binding="{Binding AssignedBranchName}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="60"/>
                <DataGridTextColumn Header="同步时间" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" Width="80"/>

                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 未关联 -->
                                <Button Content="关联已有" Style="{StaticResource PlainButtonStyle}"
                                        FontSize="12" Padding="4,2"
                                        Foreground="{StaticResource AccentBrush}"
                                        Visibility="{Binding Status, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Unlinked}"
                                        Command="{Binding DataContext.LinkCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="快速新建" Style="{StaticResource PlainButtonStyle}"
                                        FontSize="12" Padding="4,2" Margin="4,0,0,0"
                                        Foreground="#27AE60"
                                        Visibility="{Binding Status, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Unlinked}"
                                        Command="{Binding DataContext.QuickCreateAndLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                                <!-- 已关联 -->
                                <Button Content="取消关联" Style="{StaticResource PlainButtonStyle}"
                                        FontSize="12" Padding="4,2"
                                        Foreground="#E74C3C"
                                        Visibility="{Binding Status, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Linked}"
                                        Command="{Binding DataContext.UnlinkCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                                <!-- 无法识别 -->
                                <Button Content="手动分配" Style="{StaticResource PlainButtonStyle}"
                                        FontSize="12" Padding="4,2"
                                        Foreground="{StaticResource AccentBrush}"
                                        Visibility="{Binding Status, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Unidentifiable}"
                                        Command="{Binding DataContext.AssignBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 加载提示 -->
        <TextBlock Grid.Row="3" Text="正在加载..." 
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="{StaticResource TertiaryLabelBrush}"/>
    </Grid>
</UserControl>

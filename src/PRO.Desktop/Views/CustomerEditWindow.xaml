<Window x:Class="PRO.Desktop.Views.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="760" Width="780"
        MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitleStyle}"/>

            <!-- ========== 基本信息（含位置） ========== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="客户名称" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" MaxLength="20"
                                 materialDesign:HintAssist.Hint="必填，最长20字符"/>
                        <TextBlock Grid.Column="2" Text="*" Foreground="{StaticResource ErrorBrush}" 
                                   VerticalAlignment="Center" Margin="6,0,0,0" FontSize="15"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="客户类型" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="大客户" 
                                         IsChecked="{Binding CustomerType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Major}"
                                         Margin="0,0,20,0"/>
                            <RadioButton Content="细分客户" 
                                         IsChecked="{Binding CustomerType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Sub}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="手机号" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="选填，11位手机号"/>
                    </Grid>

                    <!-- 客户关联（仅细分客户显示） -->
                    <Border Margin="0,0,0,12" x:Name="MajorCustomerSection" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="所属大客户" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding MajorCustomers}"
                                      SelectedItem="{Binding SelectedMajorCustomer}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="选择大客户（可选）"/>
                        </Grid>
                    </Border>

                    <!-- 省市区 -->
                    <TextBlock Text="所在地区" Margin="0,0,0,8" Foreground="{StaticResource TertiaryLabelBrush}" FontSize="12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Provinces}"
                                  SelectedItem="{Binding Province, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="省份"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Cities}"
                                  SelectedItem="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="城市"/>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding Districts}"
                                  SelectedItem="{Binding District}"
                                  materialDesign:HintAssist.Hint="区/县"/>
                    </Grid>

                    <!-- 详细地址 + 地图选点 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="详细地址" VerticalAlignment="Top" Margin="0,10,0,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                 materialDesign:HintAssist.Hint="街道、门牌号等"/>
                        <Button Grid.Column="2" Content="🗺 地图选点" 
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12" Margin="8,0,0,0"
                                Click="MapPickerButton_Click" ToolTip="打开地图搜索并选取位置" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="经度" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Longitude, Mode=OneWay}" 
                                 Style="{StaticResource ModernTextBoxStyle}" Background="{StaticResource BackgroundBrush}"
                                 IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="纬度" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" Text="{Binding Latitude, Mode=OneWay}"
                                 Style="{StaticResource ModernTextBoxStyle}" Background="{StaticResource BackgroundBrush}"
                                 IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 详细信息 ========== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="详细信息" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="所属商圈" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BusinessDistricts}"
                                  SelectedItem="{Binding SelectedBusinessDistrict}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="选择商圈"/>
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="法人代表" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding LegalPerson, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 工商信息 ========== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="工商信息" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="注册地址" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding RegisterAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="营业执照上的注册地址"/>
                        <Button Grid.Column="2" Content="🔍 查询" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6" FontSize="12" Margin="8,0,0,0" ToolTip="通过地址搜索企业信息"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 备注 ========== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="备注" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             MaxLength="129" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="CancelButton_Click" Margin="0,0,8,0" Padding="24,9"/>
                        <Button Content="保 存" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" Padding="24,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>

<UserControl x:Class="PRO.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 欢迎区域 (Apple Today 风格) -->
            <Border Margin="0,0,0,16" Padding="24"
                    CornerRadius="12"
                    Effect="{StaticResource AppleShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#007AFF" Offset="0"/>
                        <GradientStop Color="#0055CC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White">
                            <Run Text="工作辛苦了，"/>
                            <Run Text="{Binding CurrentUserName}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding WelcomeMessage}" Foreground="#BBFFFFFF" 
                                   Margin="0,6,0,0" FontSize="13"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="8" Padding="12,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Width="14" Height="14" 
                                                     Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentDateDisplay}" 
                                       Foreground="White" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 统计卡片 (Apple 健康App风格) -->
            <UniformGrid Rows="1" Margin="0,0,0,16">
                <Border Style="{StaticResource AppleCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="7" Padding="8">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Foreground="White"/>
                            </Border>
                            <TextBlock Text="客户总数" Foreground="{StaticResource TertiaryLabelBrush}" 
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CustomerCount}" FontSize="34" FontWeight="Bold" 
                                   Foreground="{StaticResource LabelBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppleCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="7" Padding="8">
                                <materialDesign:PackIcon Kind="ClipboardText" Width="20" Height="20" Foreground="White"/>
                            </Border>
                            <TextBlock Text="本月订单" Foreground="{StaticResource TertiaryLabelBrush}" 
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthlyOrderCount}" FontSize="34" FontWeight="Bold" 
                                   Foreground="{StaticResource LabelBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppleCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource WarningBrush}" CornerRadius="7" Padding="8">
                                <materialDesign:PackIcon Kind="CurrencyCny" Width="20" Height="20" Foreground="White"/>
                            </Border>
                            <TextBlock Text="本月收款" Foreground="{StaticResource TertiaryLabelBrush}" 
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock FontSize="34" FontWeight="Bold" 
                                   Foreground="{StaticResource LabelBrush}" Margin="0,10,0,0">
                            <Run Text="¥"/><Run Text="{Binding MonthlyReceivedAmount, StringFormat=N2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppleCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource ErrorBrush}" CornerRadius="7" Padding="8">
                                <materialDesign:PackIcon Kind="TruckDelivery" Width="20" Height="20" Foreground="White"/>
                            </Border>
                            <TextBlock Text="待配送" Foreground="{StaticResource TertiaryLabelBrush}" 
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingDeliveryCount}" FontSize="34" FontWeight="Bold" 
                                   Foreground="{StaticResource LabelBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 最近订单 + 快捷操作 (Apple 双栏布局) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：最近订单 -->
                <Border Grid.Column="0" Style="{StaticResource AppleCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="最近订单" Style="{StaticResource AppleSectionTitleStyle}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding RecentOrders}"
                                  Style="{StaticResource AppleDataGridStyle}"
                                  MaxHeight="300"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="120"/>
                                <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount, StringFormat=¥{0:N2}}" Width="90"/>
                                <DataGridTemplateColumn Header="状态" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AppleTagStyle}"
                                                    Background="{Binding StatusColor, Converter={StaticResource ColorStringToBrushConverter}}">
                                                <TextBlock Text="{Binding StatusName}" Foreground="White" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 右侧：快捷操作 -->
                <Border Grid.Column="1" Style="{StaticResource AppleCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="快捷操作" Style="{StaticResource AppleSectionTitleStyle}" Margin="0,0,0,12"/>
                        
                        <Button Style="{StaticResource AppleSecondaryButtonStyle}" 
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding QuickCreateOrderCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Text="新建订单" Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource AppleSecondaryButtonStyle}" 
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding QuickCreateCustomerCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountPlus" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Text="新增客户" Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource AppleSecondaryButtonStyle}" 
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding ViewPendingOrdersCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClipboardList" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Text="待分配订单" Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource ApplePrimaryButtonStyle}" 
                                HorizontalAlignment="Stretch"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Text="刷新数据" Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 同步状态 -->
            <Border Style="{StaticResource AppleCardStyle}" Margin="0,16,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloudSync" Width="16" Height="16" 
                                              Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="数据同步：" Foreground="{StaticResource TertiaryLabelBrush}" 
                               Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding SyncStatusText}" FontWeight="SemiBold" 
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text=" · 最后同步：" Foreground="{StaticResource TertiaryLabelBrush}" 
                               Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding LastSyncTime, StringFormat=yyyy-MM-dd HH:mm:ss}" 
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

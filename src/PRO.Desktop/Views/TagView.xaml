<UserControl x:Class="PRO.Desktop.Views.TagView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="客户标签管理" Style="{StaticResource PageTitleStyle}"/>
        <StackPanel Grid.Row="1"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="创建标签" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="标签名称"/>
                <TextBox Grid.Column="1" Text="{Binding NewTagColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="8,0" materialDesign:HintAssist.Hint="颜色代码 #RRGGBB" MaxWidth="120"/>
                <Button Grid.Column="2" Content="创建" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddTagCommand}" Padding="20,7"/>
            </Grid>
        </StackPanel></Border>
        <ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource FillBrush}" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="删除" Style="{StaticResource PlainButtonStyle}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>

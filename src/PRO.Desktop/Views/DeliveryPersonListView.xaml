<UserControl x:Class="PRO.Desktop.Views.DeliveryPersonListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:PRO.Domain.Enums;assembly=PRO.Domain"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="物流管理" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="新增配送员" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding NewDeliveryPersonCommand}"/>
                    <Button Content="自动分配" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding AutoAssignCommand}"/>
                    <Button Content="高德导出" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportForGaodeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Width="250" Margin="0,0,12,0"
                         materialDesign:HintAssist.Hint="搜索配送员姓名/手机号..."/>
                
                <ComboBox Width="100" Margin="0,0,12,0"
                          materialDesign:HintAssist.Hint="状态"
                          SelectedValue="{Binding FilterStatus}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="全部" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="可用" Tag="{x:Static enums:DeliveryPersonStatus.Available}"/>
                    <ComboBoxItem Content="忙碌" Tag="{x:Static enums:DeliveryPersonStatus.Busy}"/>
                    <ComboBoxItem Content="休息" Tag="{x:Static enums:DeliveryPersonStatus.Off}"/>
                </ComboBox>
                
                <Button Content="搜索" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8"
                        Command="{Binding SearchCommand}"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="16,8"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="2" Margin="24,16">
            <DataGrid ItemsSource="{Binding DeliveryPersons}"
                      SelectedItem="{Binding SelectedDeliveryPerson}"
                      Style="{StaticResource DataGridStyle}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/>
                    <DataGridTextColumn Header="手机号" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="所属分公司" Binding="{Binding BranchName}" Width="120"/>
                    <DataGridTextColumn Header="服务区域" Binding="{Binding ServiceArea}" Width="*"/>
                    <DataGridTextColumn Header="车辆牌号" Binding="{Binding VehicleNumber}" Width="100"/>
                    <DataGridTextColumn Header="微信号" Binding="{Binding WeChatId}" Width="120"/>
                    <DataGridTemplateColumn Header="当前负载" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding CurrentLoad}" Maximum="{Binding MaxLoad}" 
                                             Height="8" Foreground="{StaticResource PrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding MaxLoad}" Width="0"/> <!-- 隐藏列用于计算 -->
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusTagStyle}"
                                        Background="{Binding Status, Converter={StaticResource DeliveryPersonStatusColorConverter}}">
                                    <TextBlock Text="{Binding StatusName}" Foreground="White" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="编辑" Padding="8,4" FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.EditDeliveryPersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="删除" Padding="8,4" FontSize="11" Foreground="{StaticResource ErrorBrush}"
                                            Style="{StaticResource PlainButtonStyle}"
                                            Command="{Binding DataContext.DeleteDeliveryPersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页栏 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="共"/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text="条记录"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PRO.Desktop.Controls.BatchProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="ProgressLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ProgressValueStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8">
        <StackPanel>
            <!-- 标题行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding BatchProgress.OperationName}" 
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LabelBrush}"/>
                <TextBlock Text=" - " Foreground="{DynamicResource SecondaryLabelBrush}"/>
                <TextBlock Text="{Binding BatchProgress.StatusText}" 
                           Style="{StaticResource ProgressLabelStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 进度条 -->
            <ProgressBar Minimum="0" Maximum="100" 
                         Value="{Binding BatchProgress.ProgressPercent}"
                         Height="6"
                         Margin="0,0,0,12"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource DividerBrush}"/>

            <!-- 统计信息 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="总数" Style="{StaticResource ProgressLabelStyle}"/>
                    <TextBlock Text="{Binding BatchProgress.TotalCount}" Style="{StaticResource ProgressValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="成功" Style="{StaticResource ProgressLabelStyle}" Foreground="#27AE60"/>
                    <TextBlock Text="{Binding BatchProgress.SuccessCount}" Style="{StaticResource ProgressValueStyle}" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="失败" Style="{StaticResource ProgressLabelStyle}" Foreground="#E74C3C"/>
                    <TextBlock Text="{Binding BatchProgress.FailedCount}" Style="{StaticResource ProgressValueStyle}" Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="跳过" Style="{StaticResource ProgressLabelStyle}" Foreground="#F39C12"/>
                    <TextBlock Text="{Binding BatchProgress.SkippedCount}" Style="{StaticResource ProgressValueStyle}" Foreground="#F39C12"/>
                </StackPanel>
            </Grid>

            <!-- 当前处理项 -->
            <TextBlock Text="{Binding BatchProgress.CurrentItemName}" 
                       Style="{StaticResource ProgressLabelStyle}"
                       Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 预计剩余时间 -->
            <TextBlock Style="{StaticResource ProgressLabelStyle}"
                       Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock.Text>
                    <Binding Path="BatchProgress.EstimatedRemaining" StringFormat="预计剩余 {0:hh\\:mm\\:ss}"/>
                </TextBlock.Text>
            </TextBlock>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="取消操作" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelBatchOperationCommand}"
                        Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="16,8" Margin="0,0,8,0"/>

                <Button Content="重试失败项" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RetryFailedBatchItemsCommand}"
                        Visibility="{Binding BatchProgress.HasFailures, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="16,8"/>
            </StackPanel>

            <!-- 失败明细 -->
            <Expander Header="失败明细" Margin="0,12,0,0"
                      Visibility="{Binding BatchProgress.HasFailures, Converter={StaticResource BoolToVisibilityConverter}}"
                      IsExpanded="False">
                <ItemsControl ItemsSource="{Binding BatchProgress.FailedItems}" x:Name="FailedItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="ItemName"/>
                                                <Binding Path="ErrorMessage"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FailedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                               FontSize="11" Foreground="{DynamicResource QuaternaryLabelBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>

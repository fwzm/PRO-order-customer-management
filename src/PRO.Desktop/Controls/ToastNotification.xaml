<UserControl x:Class="PRO.Desktop.Controls.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="Auto" Width="320">
    <Border x:Name="ToastBorder" CornerRadius="12" Padding="16,12"
            Background="#1C1C1E" Opacity="0">
        <Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="4"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="MessageText" FontSize="12" Foreground="#DDFFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>

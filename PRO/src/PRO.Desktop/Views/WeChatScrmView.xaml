<UserControl x:Class="PRO.Desktop.Views.WeChatScrmView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Background="{StaticResource ContentBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TertiaryLabelBrush}"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,0,4,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="企业微信 SCRM" Style="{StaticResource PageTitleStyle}"/>

        <!-- Tab 栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="客户" IsChecked="{Binding IsCustomersTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
            <RadioButton Content="标签" IsChecked="{Binding IsTagsTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
            <RadioButton Content="客户群" IsChecked="{Binding IsGroupChatsTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
            <RadioButton Content="消息" IsChecked="{Binding IsMessagesTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
            <RadioButton Content="联系我" IsChecked="{Binding IsContactWayTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
            <RadioButton Content="离职分配" IsChecked="{Binding IsTransferTab}" Style="{StaticResource FilterTabStyle}" GroupName="scrm"/>
        </StackPanel>

        <!-- █████████████ 客户Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsCustomersTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}" Text="{Binding CustomerCount, StringFormat=共 {0} 个企微客户}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="客户名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="添加人" Binding="{Binding AddUserName}" Width="80"/>
                    <DataGridTextColumn Header="部门" Binding="{Binding AddUserDepartmentName}" Width="100"/>
                    <DataGridTextColumn Header="归属公司" Binding="{Binding AssignedBranchName}" Width="100"/>
                    <DataGridTextColumn Header="同步" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd}}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- █████████████ 标签Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsTagsTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="管理企业微信客户标签" FontSize="13" Foreground="{StaticResource TertiaryLabelBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔄 同步标签" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SyncWeChatTagsCommand}" Padding="14,6"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="160" materialDesign:HintAssist.Hint="标签名称"/>
                <TextBox Text="{Binding NewTagGroup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="120" Margin="8,0" materialDesign:HintAssist.Hint="分组"/>
                <Button Content="创建" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateTagCommand}" Padding="16,7"/>
            </StackPanel>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border CornerRadius="16" Padding="12,5" Margin="0,0,6,6" Background="{StaticResource FillBrush}">
                        <TextBlock Text="{Binding Name}" FontSize="12"/></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- █████████████ 客户群Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsGroupChatsTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding GroupChats}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" SelectedItem="{Binding SelectedGroupChat}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="群名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="成员数" Binding="{Binding MemberCount}" Width="60"/>
                    <DataGridTextColumn Header="创建" Binding="{Binding CreateTime, StringFormat={}{0:MM-dd}}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="群成员" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding GroupChatMembers}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="8,4" Margin="0,0,0,2" CornerRadius="4" Background="{StaticResource FillBrush}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Width="120"/><TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/></StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- █████████████ 消息Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsMessagesTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="发送消息" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <TextBox Text="{Binding MessageRecipients, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="接收人（企业微信UserID，多使用|分隔）" Margin="0,0,0,12"/>
                <TextBox Text="{Binding MessageContent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" materialDesign:HintAssist.Hint="消息内容" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal"><Button Content="发送消息" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendMessageCommand}" Padding="20,8" Margin="0,0,8,0"/>
                    <Button Content="群发给所有客户" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CreateMassMessageCommand}" Padding="20,8"/></StackPanel>
                <TextBlock Text="{Binding MessageResult}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel></Border>
        </Grid>

        <!-- █████████████ 联系我Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsContactWayTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="「联系我」二维码" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="生成后客户扫码可直接添加您的企业微信" FontSize="12" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,0,0,16"/>
                <TextBox Text="{Binding ContactWayRemark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="备注说明（可选）" Margin="0,0,0,12"/>
                <Button Content="生成二维码" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateContactWayCommand}" Padding="20,8"/>
                <TextBox Text="{Binding ContactWayUrl}" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Margin="0,12,0,0" FontSize="11" Height="80"/>
            </StackPanel></Border>
        </Grid>

        <!-- █████████████ 离职分配Tab █████████████ -->
        <Grid Grid.Row="2" Visibility="{Binding IsTransferTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding UnassignedCount, StringFormat=待分配客户: {0} 个}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TertiaryLabelBrush}"/>
                <ComboBox ItemsSource="{Binding TakeoverEmployees}" SelectedItem="{Binding SelectedTakeover}" DisplayMemberPath="Name" Width="150" Margin="12,0,0,0" materialDesign:HintAssist.Hint="接管员工"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding UnassignedCustomers}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="客户名称" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="分配" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" FontSize="11"
                                Command="{Binding DataContext.TransferCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

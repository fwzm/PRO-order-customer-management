<Window x:Class="PRO.Desktop.Views.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="腾讯地图选点"
        Height="550" Width="500"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     materialDesign:HintAssist.Hint="输入地址名称搜索（如：无锡新区管委会）"
                     KeyDown="SearchBox_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchCommand}" Padding="16,8" Margin="8,0,0,0"/>
        </Grid>

        <!-- 搜索结果列表 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding SearchResults}"
                  SelectedItem="{Binding SelectedResult}"
                  Style="{StaticResource DataGridStyle}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  RowHeight="48"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 搜索状态 -->
        <TextBlock Grid.Row="1" Text="正在搜索..." Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- 选中位置预览 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,8,0,0"
                Background="{StaticResource SurfaceBrush}"
                Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="已选位置" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SelectedResult.Title}" FontSize="14"/>
                <TextBlock Text="{Binding SelectedResult.DisplayText, StringFormat='{}{0}'}" 
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" 
                    Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button Content="确认选择" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmSelectionCommand}"
                    IsEnabled="{Binding SelectedResult, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>
    </Grid>
</Window>

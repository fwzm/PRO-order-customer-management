<UserControl x:Class="PRO.Desktop.Views.PredictionDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:PRO.Desktop.ViewModels"
        xmlns:pred="clr-namespace:PRO.Desktop.Prediction"
        mc:Ignorable="d"
        d:DesignHeight="700" d:DesignWidth="1100"
        Background="{StaticResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="智能预测中心" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding LastRefreshTime, StringFormat=上次更新: {0}}" 
                           FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}" Margin="0,2,0,8"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⟳ 刷新" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}" Padding="16,7" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ═══════════ 概览卡片 ═══════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="今日预测" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <TextBlock Text="{Binding TodayOrdersText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="笔订单" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="今日预测金额" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <TextBlock Text="{Binding TodayRevenueText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="预计营收" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="本周预测" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <TextBlock Text="{Binding WeekOrdersText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="笔 / 周" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="预测新客" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <TextBlock Text="{Binding NewCustomerText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#27AE60"/>
                            <TextBlock Text="家 / 月" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="流失预警" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ChurnHighText}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/>
                                <TextBlock Text=" / " FontSize="14" Foreground="{StaticResource TertiaryLabelBrush}" VerticalAlignment="Bottom"/>
                                <TextBlock Text="{Binding ChurnMediumText}" FontSize="24" FontWeight="Bold" Foreground="#F39C12"/>
                            </StackPanel>
                            <TextBlock Text="高 / 中" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════ 预测列表 ═══════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：客户预测和产品预测 -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">

                        <!-- 即将送货预测 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📦 即将送货的客户" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding CustomerPredictions}"
                                          Style="{StaticResource DataGridStyle}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" RowHeight="36"
                                          SelectedItem="{Binding SelectedCustomerPrediction}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="预测日" Binding="{Binding PredictedNextOrderDate, StringFormat={}{0:MM-dd}}" Width="65"/>
                                        <DataGridTextColumn Header="金额" Binding="{Binding PredictedAmount, StringFormat=¥{0:N0}}" Width="75"/>
                                        <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceScore, StringFormat={}{0:N0}%}" Width="65"/>
                                        <DataGridTextColumn Header="距上次" Binding="{Binding DaysSinceLastOrder, StringFormat={}{0}天}" Width="55"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 产品销量预测 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📊 产品销量预测" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding ProductPredictions}"
                                          Style="{StaticResource DataGridStyle}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" RowHeight="36"
                                          SelectedItem="{Binding SelectedProductPrediction}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="预测销量" Binding="{Binding PredictedSales, StringFormat={}{0:N0}}" Width="70"/>
                                        <DataGridTextColumn Header="建议备货" Binding="{Binding SuggestedStock, StringFormat={}{0:N0}}" Width="70"/>
                                        <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat={}{0:N0}%}" Width="65"/>
                                        <DataGridTextColumn Header="趋势" Binding="{Binding Trend}" Width="55"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 客户流失预警 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠️ 客户流失预警" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="高" Foreground="#E74C3C" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChurnHighText}" Foreground="#E74C3C" FontWeight="Bold" FontSize="13" Margin="2,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="中" Foreground="#F39C12" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChurnMediumText}" Foreground="#F39C12" FontWeight="Bold" FontSize="13" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding ChurnWarnings}"
                                          Style="{StaticResource DataGridStyle}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" RowHeight="36"
                                          Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTemplateColumn Header="风险" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RiskLevel}" FontWeight="Bold"
                                                               Foreground="{StaticResource LabelBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="最后下单" Binding="{Binding LastOrderDate, StringFormat={}{0:MM-dd}}" Width="65"/>
                                        <DataGridTextColumn Header="已过" Binding="{Binding DaysSinceLastOrder, StringFormat={}{0}天}" Width="50"/>
                                        <DataGridTextColumn Header="平均间隔" Binding="{Binding AverageInterval, StringFormat={}{0:N1}天}" Width="65"/>
                                        <DataGridTextColumn Header="建议" Binding="{Binding SuggestedAction}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右侧：详情面板 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="预测详情" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding PredictionDetail, Mode=OneWay}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     IsReadOnly="True" Height="400"
                                     FontSize="12" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 加载 -->
        <Border Grid.Row="2" Background="{StaticResource ContentBackgroundBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="正在加载预测数据..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="{StaticResource TertiaryLabelBrush}"/>
        </Border>
    </Grid>
</UserControl>

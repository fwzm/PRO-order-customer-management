<UserControl x:Class="PRO.Desktop.Views.OrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="订单管理" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存视图" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveCurrentViewCommand}" Margin="0,0,8,0"/>
                    <Button Content="清除视图" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearSavedViewCommand}" Margin="0,0,8,0"/>
                    <Button Content="批量模式" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleBatchModeCommand}" Margin="0,0,8,0"/>
                    <Button Content="新建订单" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewOrderCommand}" Margin="0,0,8,0"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="导出Excel" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportToExcelCommand}" Margin="0,0,8,0"/>
                    <Button Content="高德规划" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportForGaodeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Width="200" Margin="0,0,8,0"
                         materialDesign:HintAssist.Hint="订单号/客户名称..."/>
                
                <ComboBox x:Name="cmbStatus" Width="120" Margin="0,0,8,0"
                          Style="{StaticResource AppleComboBoxStyle}"
                          materialDesign:HintAssist.Hint="订单状态"
                          SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="待分配" Tag="Pending"/>
                    <ComboBoxItem Content="已分配" Tag="Assigned"/>
                    <ComboBoxItem Content="配送中" Tag="Delivering"/>
                    <ComboBoxItem Content="已完成" Tag="Completed"/>
                    <ComboBoxItem Content="配送失败" Tag="Failed"/>
                    <ComboBoxItem Content="已取消" Tag="Cancelled"/>
                </ComboBox>
                
                <ComboBox x:Name="cmbPaymentStatus" Width="140" Margin="0,0,8,0"
                          Style="{StaticResource AppleComboBoxStyle}"
                          materialDesign:HintAssist.Hint="收款状态"
                          SelectedValue="{Binding FilterPaymentStatus}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="已收款" Tag="Paid"/>
                    <ComboBoxItem Content="未收款/部分收款" Tag="Unpaid"/>
                    <ComboBoxItem Content="移交法务" Tag="Legal"/>
                </ComboBox>
                
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Content="今日" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                            Command="{Binding FilterTodayCommand}"/>
                    <Button Content="本周" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Margin="4,0"
                            Command="{Binding FilterThisWeekCommand}"/>
                    <Button Content="本月" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Margin="4,0"
                            Command="{Binding FilterThisMonthCommand}"/>
                    <Button Content="自定义" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Margin="4,0"
                            Command="{Binding FilterCustomCommand}"/>
                </StackPanel>
                <Button Content="搜索" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                
                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
                <ItemsControl ItemsSource="{Binding QuickFilters}" Margin="12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.ApplyQuickFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    Margin="0,0,4,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="批量分配" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BatchAssignCommand}" Margin="8,0,0,0"/>
                <Button Content="批量确认草稿" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BatchConfirmDraftsCommand}" Margin="6,0,0,0"/>
                <CheckBox Content="全选"
                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource SecondaryLabelBrush}">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount}"/><Run Text=" 条"/>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="2" Margin="24,16" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
            <DataGrid ItemsSource="{Binding SelectableOrders}"
                      Style="{StaticResource DataGridStyle}"
                      IsReadOnly="False" CanUserResizeColumns="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <DataGrid.InputBindings>
                    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewOrderCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="订单号" Binding="{Binding Data.OrderNo}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="客户" Binding="{Binding Data.CustomerName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="总金额" Binding="{Binding Data.TotalAmount, StringFormat=¥{0:N2}}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="收款金额" Binding="{Binding Data.ReceivedAmount, StringFormat=¥{0:N2}}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="收款状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusTagStyle}"
                                        Background="{Binding Data.PaymentStatus, Converter={StaticResource PaymentStatusColorConverter}}">
                                    <TextBlock Text="{Binding Data.PaymentStatusName}" Foreground="White" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="订单状态" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusTagStyle}"
                                        Background="{Binding Data.Status, Converter={StaticResource OrderStatusColorConverter}}">
                                    <TextBlock Text="{Binding Data.StatusName}" Foreground="White" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="配送员" Binding="{Binding Data.DeliveryPersonName}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="配送地址" Binding="{Binding Data.DeliveryAddress}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding Data.CreatedAt, StringFormat=MM-dd HH:mm}" Width="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="操作" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="查看" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Data}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Content="分配" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.AssignOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Data}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Content="状态" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Data}"
                                            Visibility="{Binding Data.ValidNextStatuses.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 统一空状态控件 -->
            <controls:EmptyStateControl DataContext="{Binding EmptyState}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- 分页栏 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock VerticalAlignment="Center">
                    <Run Text="共"/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text="条记录"/>
                </TextBlock>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="首页" Command="{Binding FirstPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0">
                        <Run Text="第"/>
                        <Run Text="{Binding PageIndex}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalPages}"/>
                        <Run Text="页"/>
                    </TextBlock>
                    <Button Content="下一页" Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}" Margin="2,0"/>
                    <ComboBox SelectedValue="{Binding PageSize}" SelectedValuePath="Tag" Margin="16,0,0,0" Width="80"
                              Style="{StaticResource AppleComboBoxStyle}">
                        <ComboBoxItem Content="50" Tag="50"/>
                        <ComboBoxItem Content="100" Tag="100" IsSelected="True"/>
                        <ComboBoxItem Content="200" Tag="200"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 批量操作进度 -->
        <Border Grid.RowSpan="4" Background="#CC000000" Panel.ZIndex="100"
                Visibility="{Binding IsBatchOperating, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:BatchProgressControl DataContext="{Binding BatchProgress}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="560" MinWidth="420"/>
        </Border>

        <!-- 加载中 -->
        <Border Grid.RowSpan="4" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="加载中..." Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="PRO.Desktop.Views.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" Title="客户360视图" Height="750" Width="1000"
        MinWidth="800"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <TabControl Style="{StaticResource AppleSegmentedTabStyle}">
        <TabItem Header="概览">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- 操作按钮栏 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="编辑客户" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EditCustomerCommand}" Margin="0,0,8,0"/>
                            <Button Content="查看档案" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenArchiveCommand}" Margin="0,0,8,0"/>
                            <Button Content="返回列表" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding GoBackCommand}"/>
                        </StackPanel>
                    </Border>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0"><StackPanel><TextBlock Text="订单总数" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalOrders}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="订单总额" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:N0}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="预测下次" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding PredictedAmount, StringFormat=¥{0:N0}}" FontSize="28" FontWeight="Bold" Foreground="#27AE60"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,0,0"><StackPanel><TextBlock Text="流失风险" FontSize="11" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Text="{Binding ChurnRisk}" FontSize="28" FontWeight="Bold" Foreground="#E74C3C"/></StackPanel></Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel>
                        <TextBlock Text="基本信息" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="客户名称：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="编号：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="3" Text="{Binding CustomerNo}"/>
                        </Grid>
                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="类型：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="1" Text="{Binding CustomerTypeStr}"/>
                            <TextBlock Grid.Column="2" Text="电话：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="3" Text="{Binding CustomerPhone}"/>
                        </Grid>
                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="地址：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="1" Text="{Binding CustomerAddress}" Grid.ColumnSpan="3"/>
                        </Grid>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="开发担当：" Foreground="{StaticResource TertiaryLabelBrush}"/><TextBlock Grid.Column="1" Text="{Binding CustomerCreatorName}"/>
                            <TextBlock Grid.Column="2" Text="客户担当：" Foreground="{StaticResource TertiaryLabelBrush}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding EmployeeList}" SelectedItem="{Binding SelectedManager}" DisplayMemberPath="Name" Width="120" materialDesign:HintAssist.Hint="选择担当"/>
                                <Button Content="指定" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChangeManagerCommand}" Padding="8,4" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel></Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel>
                        <TextBlock Text="专属价格" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding CustomerPrices}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="{Binding ProductName}" Width="150"/><TextBlock Text="{Binding Price, StringFormat=¥{0:N2}}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="订单历史">
            <DataGrid ItemsSource="{Binding RecentOrders}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" Margin="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="*"/><DataGridTextColumn Header="金额" Binding="{Binding TotalAmount, StringFormat=¥{0:N2}}" Width="100"/><DataGridTextColumn Header="收款" Binding="{Binding PaymentStatus}" Width="80"/><DataGridTextColumn Header="日期" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="拜访记录">
            <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding RecentVisits}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日期" Binding="{Binding VisitDate, StringFormat={}{0:MM-dd HH:mm}}" Width="120"/><DataGridTextColumn Header="方式" Binding="{Binding VisitType}" Width="60"/><DataGridTextColumn Header="目的" Binding="{Binding Purpose}" Width="100"/><DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/><DataGridTextColumn Header="需求" Binding="{Binding CustomerDemand}" Width="100"/><DataGridTextColumn Header="下次" Binding="{Binding NextAction}" Width="120"/><DataGridTextColumn Header="拜访人" Binding="{Binding VisitorName}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="商机">
            <DataGrid ItemsSource="{Binding Opportunities}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" Margin="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="商机" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="阶段" Binding="{Binding StageName}" Width="60"/><DataGridTextColumn Header="预计金额" Binding="{Binding ExpectedAmount, StringFormat=¥{0:N0}}" Width="100"/><DataGridTextColumn Header="创建" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
    </TabControl>
</Window>

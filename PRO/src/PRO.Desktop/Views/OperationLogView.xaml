<UserControl x:Class="PRO.Desktop.Views.OperationLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:PRO.Desktop.Controls"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Text="操作日志" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" Width="180"
                         materialDesign:HintAssist.Hint="搜索关键词"/>

                <!-- 模块筛选 -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableModules}"
                          SelectedItem="{Binding FilterModule}"
                          Width="120" materialDesign:HintAssist.Hint="模块"/>

                <!-- 操作类型筛选 -->
                <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableOperationTypes}"
                          SelectedItem="{Binding FilterOperationType}"
                          Width="120" materialDesign:HintAssist.Hint="操作类型"/>

                <!-- 日期范围 -->
                <DatePicker Grid.Column="6" SelectedDate="{Binding FilterStartDate}"
                            Width="130" materialDesign:HintAssist.Hint="开始日期"/>
                <DatePicker Grid.Column="8" SelectedDate="{Binding FilterEndDate}"
                            Width="130" materialDesign:HintAssist.Hint="结束日期"/>

                <!-- 快捷日期按钮 -->
                <StackPanel Grid.Column="10" Orientation="Horizontal">
                    <Button Content="今天" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterTodayCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="本周" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterThisWeekCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="本月" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FilterThisMonthCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="清除" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFilterCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="导出" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportToExcelCommand}" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="{StaticResource SurfaceBrush}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding OperatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="80"/>
                <DataGridTextColumn Header="工号" Binding="{Binding OperatorNo}" Width="80"/>
                <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="80"/>
                <DataGridTextColumn Header="操作类型" Binding="{Binding OperationType}" Width="80"/>
                <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
        <controls:EmptyStateControl Grid.Row="2" DataContext="{Binding EmptyState}"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- 分页 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <Run Text="共 "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" 条记录"/>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="上一页" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PreviousPageCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0">
                        <Run Text="{Binding PageIndex}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding ComputedTotalPages}"/>
                    </TextBlock>
                    <Button Content="下一页" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NextPageCommand}" Padding="8,4" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

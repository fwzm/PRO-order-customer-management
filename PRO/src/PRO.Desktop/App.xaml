<Application x:Class="PRO.Desktop.App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:PRO.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                
                <!-- 自定义资源 -->
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 转换器 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter" />
            <converters:EnumBooleanConverter x:Key="EnumBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:BoolToArrowConverter x:Key="BoolToArrowConverter" />
            <converters:BoolToChevronConverter x:Key="BoolToChevronConverter" />
            <converters:BoolToLoginTextConverter x:Key="BoolToLoginTextConverter" />
            <converters:NavVisibilityConverter x:Key="NavVisibilityConverter" />
            <converters:CategoryHeaderVisibilityConverter x:Key="CategoryHeaderVisibilityConverter" />
            <converters:CategoryItemVisibilityConverter x:Key="CategoryItemVisibilityConverter" />
            <converters:NavIconConverter x:Key="NavIconConverter" />
            <converters:OrderStatusColorConverter x:Key="OrderStatusColorConverter" />
            <converters:PaymentStatusColorConverter x:Key="PaymentStatusColorConverter" />
            <converters:CustomerTypeColorConverter x:Key="CustomerTypeColorConverter" />
            <converters:DeliveryPersonStatusColorConverter x:Key="DeliveryPersonStatusColorConverter" />
            <converters:CloseBehaviorConverter x:Key="CloseBehaviorConverter" />
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
            <converters:ProductStatusColorConverter x:Key="ProductStatusColorConverter" />
            <converters:ProductStatusTextConverter x:Key="ProductStatusTextConverter" />
            <converters:PasswordHintConverter x:Key="PasswordHintConverter" />
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
            <converters:BoolToEnabledConverter x:Key="BoolToEnabledConverter" />
            <converters:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter" />
            <converters:EnumVisibilityConverter x:Key="EnumVisibilityConverter" />
            <converters:StringEqualsVisibilityConverter x:Key="StringEqualsVisibilityConverter" />
            <converters:BadgeVisibilityConverter x:Key="BadgeVisibilityConverter" />
            <converters:BadgeTextConverter x:Key="BadgeTextConverter" />
            <converters:SearchMatchVisibilityConverter x:Key="SearchMatchVisibilityConverter" />
            <converters:ExpandedToAngleConverter x:Key="ExpandedToAngleConverter" />
            <converters:OrderStatusTextConverter x:Key="OrderStatusTextConverter" />
            <converters:PaymentStatusTextConverter x:Key="PaymentStatusTextConverter" />
            <converters:DeliveryPersonStatusTextConverter x:Key="DeliveryPersonStatusTextConverter" />
            <converters:CustomerTypeTextConverter x:Key="CustomerTypeTextConverter" />
            <converters:DistrictStatusTextConverter x:Key="DistrictStatusTextConverter" />
            <converters:DistrictStatusColorConverter x:Key="DistrictStatusColorConverter" />
            
            <!-- 全局样式 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

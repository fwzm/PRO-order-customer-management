<UserControl x:Class="PRO.Desktop.Controls.LoadingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="600">
    <Border x:Name="OverlayBorder" Background="#B3FFFFFF" Visibility="Collapsed">
        <Border.Effect>
            <BlurEffect Radius="2"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 旋转加载动画 -->
            <Grid Width="40" Height="40" HorizontalAlignment="Center">
                <Ellipse Stroke="#E0E0E0" StrokeThickness="3" Width="40" Height="40"/>
                <Ellipse x:Name="SpinnerArc" Stroke="{StaticResource AccentBrush}" 
                         StrokeThickness="3" Width="40" Height="40"
                         StrokeDashArray="5,15" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="LoadingText" Text="加载中..." FontSize="13"
                       Foreground="#666666" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>

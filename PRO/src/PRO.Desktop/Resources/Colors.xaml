<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Apple SF 风格配色方案 -->
    
    <!-- ========== Apple System Colors ========== -->
    <Color x:Key="AppleBlue">#007AFF</Color>
    <Color x:Key="AppleGreen">#34C759</Color>
    <Color x:Key="AppleOrange">#FF9500</Color>
    <Color x:Key="AppleRed">#FF3B30</Color>
    <Color x:Key="ApplePurple">#5856D6</Color>
    <Color x:Key="AppleYellow">#FFCC00</Color>
    <Color x:Key="AppleTeal">#5AC8FA</Color>
    <Color x:Key="ApplePink">#FF2D55</Color>

    <!-- ========== Apple System Grays ========== -->
    <Color x:Key="AppleGray1">#8E8E93</Color>
    <Color x:Key="AppleGray2">#AEAEB2</Color>
    <Color x:Key="AppleGray3">#C7C7CC</Color>
    <Color x:Key="AppleGray4">#D1D1D6</Color>
    <Color x:Key="AppleGray5">#E5E5EA</Color>
    <Color x:Key="AppleGray6">#F2F2F7</Color>

    <!-- ========== 主色（使用 Apple Blue 作为强调色） ========== -->
    <Color x:Key="AccentColor">#007AFF</Color>
    <Color x:Key="AccentHighlightColor">#0066D6</Color>
    <Color x:Key="AccentDimColor">#4DA3FF</Color>

    <!-- ========== 兼容旧版颜色键（LoginWindow 等引用） ========== -->
    <Color x:Key="PrimaryColor">#007AFF</Color>
    <Color x:Key="PrimaryLightColor">#4DA3FF</Color>
    <Color x:Key="PrimaryDarkColor">#0066D6</Color>

    <!-- ========== 背景色系 ========== -->
    <Color x:Key="WindowBackgroundColor">#F2F2F7</Color>
    <Color x:Key="SidebarBackgroundColor">#EBEBF0</Color>
    <Color x:Key="SidebarDividerColor">#D2D2D8</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ContentBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ToolbarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HoverBackgroundColor">#E1E1E7</Color>
    <Color x:Key="SelectedBackgroundColor">#D5E4F7</Color>

    <!-- ========== 文字色系 ========== -->
    <Color x:Key="LabelColor">#1C1C1E</Color>
    <Color x:Key="SecondaryLabelColor">#3A3A3C</Color>
    <Color x:Key="TertiaryLabelColor">#8E8E93</Color>
    <Color x:Key="QuaternaryLabelColor">#C7C7CC</Color>
    <Color x:Key="PlaceholderColor">#C7C7CC</Color>
    <Color x:Key="SeparatorColor">#C6C6C8</Color>
    <Color x:Key="FillColor">#E5E5EA</Color>

    <!-- ========== 功能色 ========== -->
    <Color x:Key="SuccessColor">#34C759</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="ErrorColor">#FF3B30</Color>
    <Color x:Key="InfoColor">#5AC8FA</Color>

    <!-- ========== 侧边栏导航 ========== -->
    <Color x:Key="NavSelectedColor">#E3F0FF</Color>
    <Color x:Key="NavHoverColor">#E8E8ED</Color>
    <Color x:Key="NavIconColor">#007AFF</Color>
    <Color x:Key="NavTextColor">#1C1C1E</Color>
    <Color x:Key="NavSelectedTextColor">#007AFF</Color>

    <!-- ========== 画刷 ========== -->
    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHighlightBrush" Color="{StaticResource AccentHighlightColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDividerColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="LabelBrush" Color="{StaticResource LabelColor}" />
    <SolidColorBrush x:Key="SecondaryLabelBrush" Color="{StaticResource SecondaryLabelColor}" />
    <SolidColorBrush x:Key="TertiaryLabelBrush" Color="{StaticResource TertiaryLabelColor}" />
    <SolidColorBrush x:Key="QuaternaryLabelBrush" Color="{StaticResource QuaternaryLabelColor}" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="{StaticResource PlaceholderColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="FillBrush" Color="{StaticResource FillColor}" />

    <!-- 功能 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- 导航 -->
    <SolidColorBrush x:Key="NavSelectedBgBrush" Color="{StaticResource NavSelectedColor}" />
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="{StaticResource NavHoverColor}" />
    <SolidColorBrush x:Key="NavIconBrush" Color="{StaticResource NavIconColor}" />
    <SolidColorBrush x:Key="NavTextBrush" Color="{StaticResource NavTextColor}" />
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="{StaticResource NavSelectedTextColor}" />

    <!-- 角标 -->
    <Color x:Key="BadgeColor">#FF3B30</Color>
    <Color x:Key="BadgeTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="BadgeBrush" Color="{StaticResource BadgeColor}" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}" />

    <!-- 阴影 -->
    <DropShadowEffect x:Key="AppleShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.08" Color="Black" />
    <DropShadowEffect x:Key="AppleShadowLight" BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="Black" />
    <DropShadowEffect x:Key="AppleShadowMedium" BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="Black" />

    <!-- 兼容旧资源名 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource AccentHighlightColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource LabelColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TertiaryLabelColor}" />
    <SolidColorBrush x:Key="TextLightBrush" Color="White" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource FillColor}" />
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentDimColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentHighlightColor}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>

<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PRO.Mobile"
             x:Class="PRO.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 值转换器 -->
            <local:InvertBoolConverter x:Key="InvertBoolConverter" />
            <local:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- 品牌色 -->
            <Color x:Key="PrimaryColor">#409EFF</Color>
            <Color x:Key="SuccessColor">#67C23A</Color>
            <Color x:Key="WarningColor">#E6A23C</Color>
            <Color x:Key="DangerColor">#F56C6C</Color>
            <Color x:Key="InfoColor">#909399</Color>
            <Color x:Key="TextPrimary">#303133</Color>
            <Color x:Key="TextRegular">#606266</Color>
            <Color x:Key="TextSecondary">#909399</Color>
            <Color x:Key="BorderColor">#DCDFE6</Color>
            <Color x:Key="BgColor">#F5F7FA</Color>

            <!-- 全局样式 -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style TargetType="Button" x:Key="DangerButton">
                <Setter Property="BackgroundColor" Value="{StaticResource DangerColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style TargetType="Label" x:Key="TitleLabel">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Label" x:Key="SubtitleLabel">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
